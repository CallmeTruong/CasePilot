# Copy to .env locally. Never send real keys in chat or commit them.
# Assistant: OpenAI-compatible LangChain model (openai/ prefix is accepted).
# Benchmark user simulator still uses tau2/LiteLLM identifiers.
CASEPILOT_MODEL=openai/gpt-6-luna
CASEPILOT_USER_MODEL=openai/gpt-6-luna
OPENAI_BASE_URL=
# BASE_URL is accepted as a fallback alias for OPENAI_BASE_URL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: absolute path to an existing, verified checkout at the pinned commit.
CASEPILOT_BENCHMARK_PATH=
# Optional LangSmith metadata export uses PROCESS environment variables (see docs/framework-runtime.md).
# CASEPILOT_LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=casepilot
